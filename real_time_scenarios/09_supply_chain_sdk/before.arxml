                <SW-COMPONENT-PROTOTYPE><SHORT-NAME>laneKeep</SHORT-NAME><TYPE-TREF DEST="APPLICATION-SW-COMPONENT-TYPE">/FV/Swc/LaneKeepAssist</TYPE-TREF></SW-COMPONENT-PROTOTYPE>
                <!-- Chassis -->
                <SW-COMPONENT-PROTOTYPE><SHORT-NAME>brakeCtl</SHORT-NAME><TYPE-TREF DEST="APPLICATION-SW-COMPONENT-TYPE">/FV/Swc/BrakeController</TYPE-TREF></SW-COMPONENT-PROTOTYPE>
                <SW-COMPONENT-PROTOTYPE><SHORT-NAME>brakeAct</SHORT-NAME><TYPE-TREF DEST="SENSOR-ACTUATOR-SW-COMPONENT-TYPE">/FV/Swc/BrakeActuator</TYPE-TREF></SW-COMPONENT-PROTOTYPE>
                <SW-COMPONENT-PROTOTYPE><SHORT-NAME>steerCtl</SHORT-NAME><TYPE-TREF DEST="SENSOR-ACTUATOR-SW-COMPONENT-TYPE">/FV/Swc/SteeringController</TYPE-TREF></SW-COMPONENT-PROTOTYPE>
                <!-- Powertrain -->
