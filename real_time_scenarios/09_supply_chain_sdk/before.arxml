                <ASSEMBLY-SW-CONNECTOR><SHORT-NAME>otaToGw</SHORT-NAME><PROVIDER-IREF><CONTEXT-COMPONENT-REF DEST="SW-COMPONENT-PROTOTYPE">/FV/Swc/FullVehicle/otaManager</CONTEXT-COMPONENT-REF><TARGET-P-PORT-REF DEST="P-PORT-PROTOTYPE">/FV/Swc/OtaManager/OtaOut</TARGET-P-PORT-REF></PROVIDER-IREF><REQUESTER-IREF><CONTEXT-COMPONENT-REF DEST="SW-COMPONENT-PROTOTYPE">/FV/Swc/FullVehicle/cgw</CONTEXT-COMPONENT-REF><TARGET-R-PORT-REF DEST="R-PORT-PROTOTYPE">/FV/Swc/CentralGateway/OtaIn</TARGET-R-PORT-REF></REQUESTER-IREF></ASSEMBLY-SW-CONNECTOR>
                <ASSEMBLY-SW-CONNECTOR><SHORT-NAME>v2xToGw</SHORT-NAME><PROVIDER-IREF><CONTEXT-COMPONENT-REF DEST="SW-COMPONENT-PROTOTYPE">/FV/Swc/FullVehicle/v2xStack</CONTEXT-COMPONENT-REF><TARGET-P-PORT-REF DEST="P-PORT-PROTOTYPE">/FV/Swc/V2xStack/V2xOut</TARGET-P-PORT-REF></PROVIDER-IREF><REQUESTER-IREF><CONTEXT-COMPONENT-REF DEST="SW-COMPONENT-PROTOTYPE">/FV/Swc/FullVehicle/cgw</CONTEXT-COMPONENT-REF><TARGET-R-PORT-REF DEST="R-PORT-PROTOTYPE">/FV/Swc/CentralGateway/V2xIn</TARGET-R-PORT-REF></REQUESTER-IREF></ASSEMBLY-SW-CONNECTOR>
                <!-- Gateway internal -->
                <ASSEMBLY-SW-CONNECTOR><SHORT-NAME>gwToDiag</SHORT-NAME><PROVIDER-IREF><CONTEXT-COMPONENT-REF DEST="SW-COMPONENT-PROTOTYPE">/FV/Swc/FullVehicle/cgw</CONTEXT-COMPONENT-REF><TARGET-P-PORT-REF DEST="P-PORT-PROTOTYPE">/FV/Swc/CentralGateway/DiagOut</TARGET-P-PORT-REF></PROVIDER-IREF><REQUESTER-IREF><CONTEXT-COMPONENT-REF DEST="SW-COMPONENT-PROTOTYPE">/FV/Swc/FullVehicle/diagRouter</CONTEXT-COMPONENT-REF><TARGET-R-PORT-REF DEST="R-PORT-PROTOTYPE">/FV/Swc/DiagnosticRouter/DiagIn</TARGET-R-PORT-REF></REQUESTER-IREF></ASSEMBLY-SW-CONNECTOR>
                <ASSEMBLY-SW-CONNECTOR><SHORT-NAME>gwToFw</SHORT-NAME><PROVIDER-IREF><CONTEXT-COMPONENT-REF DEST="SW-COMPONENT-PROTOTYPE">/FV/Swc/FullVehicle/cgw</CONTEXT-COMPONENT-REF><TARGET-P-PORT-REF DEST="P-PORT-PROTOTYPE">/FV/Swc/CentralGateway/FwOut</TARGET-P-PORT-REF></PROVIDER-IREF><REQUESTER-IREF><CONTEXT-COMPONENT-REF DEST="SW-COMPONENT-PROTOTYPE">/FV/Swc/FullVehicle/firewallMgr</CONTEXT-COMPONENT-REF><TARGET-R-PORT-REF DEST="R-PORT-PROTOTYPE">/FV/Swc/FirewallManager/FwIn</TARGET-R-PORT-REF></REQUESTER-IREF></ASSEMBLY-SW-CONNECTOR>
                <!-- Gateway -> ADAS (BUS, deliberately NOT connected in before) -->
                <!-- ComfortOut -> ComfortIn is ABSENT: this is the same isolation as scenario_b -->
                <!-- Gateway -> ADAS (Decel path exists: adas -> brakeCtl) -->
                <ASSEMBLY-SW-CONNECTOR><SHORT-NAME>adasToDecel</SHORT-NAME><PROVIDER-IREF><CONTEXT-COMPONENT-REF DEST="SW-COMPONENT-PROTOTYPE">/FV/Swc/FullVehicle/adas</CONTEXT-COMPONENT-REF><TARGET-P-PORT-REF DEST="P-PORT-PROTOTYPE">/FV/Swc/AdasPlanner/DecelOut</TARGET-P-PORT-REF></PROVIDER-IREF><REQUESTER-IREF><CONTEXT-COMPONENT-REF DEST="SW-COMPONENT-PROTOTYPE">/FV/Swc/FullVehicle/brakeCtl</CONTEXT-COMPONENT-REF><TARGET-R-PORT-REF DEST="R-PORT-PROTOTYPE">/FV/Swc/BrakeController/DecelIn</TARGET-R-PORT-REF></REQUESTER-IREF></ASSEMBLY-SW-CONNECTOR>
                <!-- ADAS internal -->
                <ASSEMBLY-SW-CONNECTOR><SHORT-NAME>adasToObj</SHORT-NAME><PROVIDER-IREF><CONTEXT-COMPONENT-REF DEST="SW-COMPONENT-PROTOTYPE">/FV/Swc/FullVehicle/adas</CONTEXT-COMPONENT-REF><TARGET-P-PORT-REF DEST="P-PORT-PROTOTYPE">/FV/Swc/AdasPlanner/ObjOut</TARGET-P-PORT-REF></PROVIDER-IREF><REQUESTER-IREF><CONTEXT-COMPONENT-REF DEST="SW-COMPONENT-PROTOTYPE">/FV/Swc/FullVehicle/objDetect</CONTEXT-COMPONENT-REF><TARGET-R-PORT-REF DEST="R-PORT-PROTOTYPE">/FV/Swc/ObjectDetector/ObjIn</TARGET-R-PORT-REF></REQUESTER-IREF></ASSEMBLY-SW-CONNECTOR>
                <ASSEMBLY-SW-CONNECTOR><SHORT-NAME>adasToLane</SHORT-NAME><PROVIDER-IREF><CONTEXT-COMPONENT-REF DEST="SW-COMPONENT-PROTOTYPE">/FV/Swc/FullVehicle/adas</CONTEXT-COMPONENT-REF><TARGET-P-PORT-REF DEST="P-PORT-PROTOTYPE">/FV/Swc/AdasPlanner/LaneOut</TARGET-P-PORT-REF></PROVIDER-IREF><REQUESTER-IREF><CONTEXT-COMPONENT-REF DEST="SW-COMPONENT-PROTOTYPE">/FV/Swc/FullVehicle/laneKeep</CONTEXT-COMPONENT-REF><TARGET-R-PORT-REF DEST="R-PORT-PROTOTYPE">/FV/Swc/LaneKeepAssist/LaneIn</TARGET-R-PORT-REF></REQUESTER-IREF></ASSEMBLY-SW-CONNECTOR>
                <!-- Chassis internal -->
                <ASSEMBLY-SW-CONNECTOR><SHORT-NAME>brakeToAct</SHORT-NAME><PROVIDER-IREF><CONTEXT-COMPONENT-REF DEST="SW-COMPONENT-PROTOTYPE">/FV/Swc/FullVehicle/brakeCtl</CONTEXT-COMPONENT-REF><TARGET-P-PORT-REF DEST="P-PORT-PROTOTYPE">/FV/Swc/BrakeController/ForceOut</TARGET-P-PORT-REF></PROVIDER-IREF><REQUESTER-IREF><CONTEXT-COMPONENT-REF DEST="SW-COMPONENT-PROTOTYPE">/FV/Swc/FullVehicle/brakeAct</CONTEXT-COMPONENT-REF><TARGET-R-PORT-REF DEST="R-PORT-PROTOTYPE">/FV/Swc/BrakeActuator/ForceIn</TARGET-R-PORT-REF></REQUESTER-IREF></ASSEMBLY-SW-CONNECTOR>
                <ASSEMBLY-SW-CONNECTOR><SHORT-NAME>brakeToSteer</SHORT-NAME><PROVIDER-IREF><CONTEXT-COMPONENT-REF DEST="SW-COMPONENT-PROTOTYPE">/FV/Swc/FullVehicle/brakeCtl</CONTEXT-COMPONENT-REF><TARGET-P-PORT-REF DEST="P-PORT-PROTOTYPE">/FV/Swc/BrakeController/SteerOut</TARGET-P-PORT-REF></PROVIDER-IREF><REQUESTER-IREF><CONTEXT-COMPONENT-REF DEST="SW-COMPONENT-PROTOTYPE">/FV/Swc/FullVehicle/steerCtl</CONTEXT-COMPONENT-REF><TARGET-R-PORT-REF DEST="R-PORT-PROTOTYPE">/FV/Swc/SteeringController/SteerIn</TARGET-R-PORT-REF></REQUESTER-IREF></ASSEMBLY-SW-CONNECTOR>
                <!-- Gateway -> Powertrain (BUS) -->
                <ASSEMBLY-SW-CONNECTOR><SHORT-NAME>gwToEngine</SHORT-NAME><PROVIDER-IREF><CONTEXT-COMPONENT-REF DEST="SW-COMPONENT-PROTOTYPE">/FV/Swc/FullVehicle/cgw</CONTEXT-COMPONENT-REF><TARGET-P-PORT-REF DEST="P-PORT-PROTOTYPE">/FV/Swc/CentralGateway/EngineOut</TARGET-P-PORT-REF></PROVIDER-IREF><REQUESTER-IREF><CONTEXT-COMPONENT-REF DEST="SW-COMPONENT-PROTOTYPE">/FV/Swc/FullVehicle/engineCtl</CONTEXT-COMPONENT-REF><TARGET-R-PORT-REF DEST="R-PORT-PROTOTYPE">/FV/Swc/EngineController/EngIn</TARGET-R-PORT-REF></REQUESTER-IREF></ASSEMBLY-SW-CONNECTOR>
                <!-- Powertrain internal -->
                <ASSEMBLY-SW-CONNECTOR><SHORT-NAME>engToTrans</SHORT-NAME><PROVIDER-IREF><CONTEXT-COMPONENT-REF DEST="SW-COMPONENT-PROTOTYPE">/FV/Swc/FullVehicle/engineCtl</CONTEXT-COMPONENT-REF><TARGET-P-PORT-REF DEST="P-PORT-PROTOTYPE">/FV/Swc/EngineController/TransOut</TARGET-P-PORT-REF></PROVIDER-IREF><REQUESTER-IREF><CONTEXT-COMPONENT-REF DEST="SW-COMPONENT-PROTOTYPE">/FV/Swc/FullVehicle/transCtl</CONTEXT-COMPONENT-REF><TARGET-R-PORT-REF DEST="R-PORT-PROTOTYPE">/FV/Swc/TransmissionCtrl/TransIn</TARGET-R-PORT-REF></REQUESTER-IREF></ASSEMBLY-SW-CONNECTOR>
                <ASSEMBLY-SW-CONNECTOR><SHORT-NAME>engToEmis</SHORT-NAME><PROVIDER-IREF><CONTEXT-COMPONENT-REF DEST="SW-COMPONENT-PROTOTYPE">/FV/Swc/FullVehicle/engineCtl</CONTEXT-COMPONENT-REF><TARGET-P-PORT-REF DEST="P-PORT-PROTOTYPE">/FV/Swc/EngineController/EmisOut</TARGET-P-PORT-REF></PROVIDER-IREF><REQUESTER-IREF><CONTEXT-COMPONENT-REF DEST="SW-COMPONENT-PROTOTYPE">/FV/Swc/FullVehicle/emisCtl</CONTEXT-COMPONENT-REF><TARGET-R-PORT-REF DEST="R-PORT-PROTOTYPE">/FV/Swc/EmissionsCtrl/EmisIn</TARGET-R-PORT-REF></REQUESTER-IREF></ASSEMBLY-SW-CONNECTOR>
                <!-- Gateway -> Body (BUS) -->
                <ASSEMBLY-SW-CONNECTOR><SHORT-NAME>gwToBody</SHORT-NAME><PROVIDER-IREF><CONTEXT-COMPONENT-REF DEST="SW-COMPONENT-PROTOTYPE">/FV/Swc/FullVehicle/cgw</CONTEXT-COMPONENT-REF><TARGET-P-PORT-REF DEST="P-PORT-PROTOTYPE">/FV/Swc/CentralGateway/BodyOut</TARGET-P-PORT-REF></PROVIDER-IREF><REQUESTER-IREF><CONTEXT-COMPONENT-REF DEST="SW-COMPONENT-PROTOTYPE">/FV/Swc/FullVehicle/bcm</CONTEXT-COMPONENT-REF><TARGET-R-PORT-REF DEST="R-PORT-PROTOTYPE">/FV/Swc/BodyControlModule/BodyIn</TARGET-R-PORT-REF></REQUESTER-IREF></ASSEMBLY-SW-CONNECTOR>
                <!-- Body internal -->
                <ASSEMBLY-SW-CONNECTOR><SHORT-NAME>bcmToDoor</SHORT-NAME><PROVIDER-IREF><CONTEXT-COMPONENT-REF DEST="SW-COMPONENT-PROTOTYPE">/FV/Swc/FullVehicle/bcm</CONTEXT-COMPONENT-REF><TARGET-P-PORT-REF DEST="P-PORT-PROTOTYPE">/FV/Swc/BodyControlModule/DoorOut</TARGET-P-PORT-REF></PROVIDER-IREF><REQUESTER-IREF><CONTEXT-COMPONENT-REF DEST="SW-COMPONENT-PROTOTYPE">/FV/Swc/FullVehicle/doorLock</CONTEXT-COMPONENT-REF><TARGET-R-PORT-REF DEST="R-PORT-PROTOTYPE">/FV/Swc/DoorLockActuator/DoorIn</TARGET-R-PORT-REF></REQUESTER-IREF></ASSEMBLY-SW-CONNECTOR>
                <ASSEMBLY-SW-CONNECTOR><SHORT-NAME>bcmToHvac</SHORT-NAME><PROVIDER-IREF><CONTEXT-COMPONENT-REF DEST="SW-COMPONENT-PROTOTYPE">/FV/Swc/FullVehicle/bcm</CONTEXT-COMPONENT-REF><TARGET-P-PORT-REF DEST="P-PORT-PROTOTYPE">/FV/Swc/BodyControlModule/HvacOut</TARGET-P-PORT-REF></PROVIDER-IREF><REQUESTER-IREF><CONTEXT-COMPONENT-REF DEST="SW-COMPONENT-PROTOTYPE">/FV/Swc/FullVehicle/hvacCtl</CONTEXT-COMPONENT-REF><TARGET-R-PORT-REF DEST="R-PORT-PROTOTYPE">/FV/Swc/HvacController/HvacIn</TARGET-R-PORT-REF></REQUESTER-IREF></ASSEMBLY-SW-CONNECTOR>
                <!-- Gateway -> Lighting (BUS) -->
                <ASSEMBLY-SW-CONNECTOR><SHORT-NAME>gwToLight</SHORT-NAME><PROVIDER-IREF><CONTEXT-COMPONENT-REF DEST="SW-COMPONENT-PROTOTYPE">/FV/Swc/FullVehicle/cgw</CONTEXT-COMPONENT-REF><TARGET-P-PORT-REF DEST="P-PORT-PROTOTYPE">/FV/Swc/CentralGateway/LightOut</TARGET-P-PORT-REF></PROVIDER-IREF><REQUESTER-IREF><CONTEXT-COMPONENT-REF DEST="SW-COMPONENT-PROTOTYPE">/FV/Swc/FullVehicle/headlight</CONTEXT-COMPONENT-REF><TARGET-R-PORT-REF DEST="R-PORT-PROTOTYPE">/FV/Swc/HeadlightCtrl/LightIn</TARGET-R-PORT-REF></REQUESTER-IREF></ASSEMBLY-SW-CONNECTOR>
                <!-- Lighting internal -->
                <ASSEMBLY-SW-CONNECTOR><SHORT-NAME>headToTail</SHORT-NAME><PROVIDER-IREF><CONTEXT-COMPONENT-REF DEST="SW-COMPONENT-PROTOTYPE">/FV/Swc/FullVehicle/headlight</CONTEXT-COMPONENT-REF><TARGET-P-PORT-REF DEST="P-PORT-PROTOTYPE">/FV/Swc/HeadlightCtrl/TailOut</TARGET-P-PORT-REF></PROVIDER-IREF><REQUESTER-IREF><CONTEXT-COMPONENT-REF DEST="SW-COMPONENT-PROTOTYPE">/FV/Swc/FullVehicle/taillight</CONTEXT-COMPONENT-REF><TARGET-R-PORT-REF DEST="R-PORT-PROTOTYPE">/FV/Swc/TaillightCtrl/TailIn</TARGET-R-PORT-REF></REQUESTER-IREF></ASSEMBLY-SW-CONNECTOR>
                <ASSEMBLY-SW-CONNECTOR><SHORT-NAME>headToAmbient</SHORT-NAME><PROVIDER-IREF><CONTEXT-COMPONENT-REF DEST="SW-COMPONENT-PROTOTYPE">/FV/Swc/FullVehicle/headlight</CONTEXT-COMPONENT-REF><TARGET-P-PORT-REF DEST="P-PORT-PROTOTYPE">/FV/Swc/HeadlightCtrl/AmbientOut</TARGET-P-PORT-REF></PROVIDER-IREF><REQUESTER-IREF><CONTEXT-COMPONENT-REF DEST="SW-COMPONENT-PROTOTYPE">/FV/Swc/FullVehicle/ambientLight</CONTEXT-COMPONENT-REF><TARGET-R-PORT-REF DEST="R-PORT-PROTOTYPE">/FV/Swc/AmbientLightCtrl/AmbientIn</TARGET-R-PORT-REF></REQUESTER-IREF></ASSEMBLY-SW-CONNECTOR>
              </CONNECTORS>
            </COMPOSITION-SW-COMPONENT-TYPE>
          </ELEMENTS>
        </AR-PACKAGE>

        <!-- ============================================================= -->
        <!-- COMMUNICATION: Signal chains for BUS hops                      -->
        <!-- ============================================================= -->
        <AR-PACKAGE>
          <SHORT-NAME>Comm</SHORT-NAME>
          <ELEMENTS>
            <!-- Nav: IVI -> GW (SecOC) -->
            <SYSTEM-SIGNAL><SHORT-NAME>NavSSig</SHORT-NAME></SYSTEM-SIGNAL>
            <I-SIGNAL><SHORT-NAME>NavISig</SHORT-NAME><SYSTEM-SIGNAL-REF DEST="SYSTEM-SIGNAL">/FV/Comm/NavSSig</SYSTEM-SIGNAL-REF></I-SIGNAL>
            <I-SIGNAL-I-PDU><SHORT-NAME>NavIPdu</SHORT-NAME><I-SIGNAL-TO-PDU-MAPPINGS><I-SIGNAL-TO-I-PDU-MAPPING><SHORT-NAME>NavMap</SHORT-NAME><I-SIGNAL-REF DEST="I-SIGNAL">/FV/Comm/NavISig</I-SIGNAL-REF></I-SIGNAL-TO-I-PDU-MAPPING></I-SIGNAL-TO-PDU-MAPPINGS></I-SIGNAL-I-PDU>
            <SECURED-I-PDU><SHORT-NAME>NavSecuredIPdu</SHORT-NAME><AUTH-INFO-TX-LENGTH>32</AUTH-INFO-TX-LENGTH><FRESHNESS-VALUE-ID>1</FRESHNESS-VALUE-ID><FRESHNESS-VALUE-LENGTH>8</FRESHNESS-VALUE-LENGTH><PAYLOAD-REF DEST="I-SIGNAL-I-PDU">/FV/Comm/NavIPdu</PAYLOAD-REF></SECURED-I-PDU>

            <!-- TCU -> GW (SecOC) -->
            <SYSTEM-SIGNAL><SHORT-NAME>TcuGwSSig</SHORT-NAME></SYSTEM-SIGNAL>
            <I-SIGNAL><SHORT-NAME>TcuGwISig</SHORT-NAME><SYSTEM-SIGNAL-REF DEST="SYSTEM-SIGNAL">/FV/Comm/TcuGwSSig</SYSTEM-SIGNAL-REF></I-SIGNAL>
            <I-SIGNAL-I-PDU><SHORT-NAME>TcuGwIPdu</SHORT-NAME><I-SIGNAL-TO-PDU-MAPPINGS><I-SIGNAL-TO-I-PDU-MAPPING><SHORT-NAME>TcuGwMap</SHORT-NAME><I-SIGNAL-REF DEST="I-SIGNAL">/FV/Comm/TcuGwISig</I-SIGNAL-REF></I-SIGNAL-TO-I-PDU-MAPPING></I-SIGNAL-TO-PDU-MAPPINGS></I-SIGNAL-I-PDU>
            <SECURED-I-PDU><SHORT-NAME>TcuGwSecuredIPdu</SHORT-NAME><AUTH-INFO-TX-LENGTH>32</AUTH-INFO-TX-LENGTH><FRESHNESS-VALUE-ID>2</FRESHNESS-VALUE-ID><FRESHNESS-VALUE-LENGTH>8</FRESHNESS-VALUE-LENGTH><PAYLOAD-REF DEST="I-SIGNAL-I-PDU">/FV/Comm/TcuGwIPdu</PAYLOAD-REF></SECURED-I-PDU>

            <!-- OTA -> GW (no SecOC — plumbed but unprotected) -->
            <SYSTEM-SIGNAL><SHORT-NAME>OtaSSig</SHORT-NAME></SYSTEM-SIGNAL>
            <I-SIGNAL><SHORT-NAME>OtaISig</SHORT-NAME><SYSTEM-SIGNAL-REF DEST="SYSTEM-SIGNAL">/FV/Comm/OtaSSig</SYSTEM-SIGNAL-REF></I-SIGNAL>
            <I-SIGNAL-I-PDU><SHORT-NAME>OtaIPdu</SHORT-NAME><I-SIGNAL-TO-PDU-MAPPINGS><I-SIGNAL-TO-I-PDU-MAPPING><SHORT-NAME>OtaMap</SHORT-NAME><I-SIGNAL-REF DEST="I-SIGNAL">/FV/Comm/OtaISig</I-SIGNAL-REF></I-SIGNAL-TO-I-PDU-MAPPING></I-SIGNAL-TO-PDU-MAPPINGS></I-SIGNAL-I-PDU>

            <!-- V2X -> GW (SecOC) -->
            <SYSTEM-SIGNAL><SHORT-NAME>V2xSSig</SHORT-NAME></SYSTEM-SIGNAL>
            <I-SIGNAL><SHORT-NAME>V2xISig</SHORT-NAME><SYSTEM-SIGNAL-REF DEST="SYSTEM-SIGNAL">/FV/Comm/V2xSSig</SYSTEM-SIGNAL-REF></I-SIGNAL>
            <I-SIGNAL-I-PDU><SHORT-NAME>V2xIPdu</SHORT-NAME><I-SIGNAL-TO-PDU-MAPPINGS><I-SIGNAL-TO-I-PDU-MAPPING><SHORT-NAME>V2xMap</SHORT-NAME><I-SIGNAL-REF DEST="I-SIGNAL">/FV/Comm/V2xISig</I-SIGNAL-REF></I-SIGNAL-TO-I-PDU-MAPPING></I-SIGNAL-TO-PDU-MAPPINGS></I-SIGNAL-I-PDU>
            <SECURED-I-PDU><SHORT-NAME>V2xSecuredIPdu</SHORT-NAME><AUTH-INFO-TX-LENGTH>32</AUTH-INFO-TX-LENGTH><FRESHNESS-VALUE-ID>3</FRESHNESS-VALUE-ID><FRESHNESS-VALUE-LENGTH>8</FRESHNESS-VALUE-LENGTH><PAYLOAD-REF DEST="I-SIGNAL-I-PDU">/FV/Comm/V2xIPdu</PAYLOAD-REF></SECURED-I-PDU>

            <!-- Comfort: GW -> ADAS (plumbed, no SecOC — like scenario_b) -->
            <SYSTEM-SIGNAL><SHORT-NAME>ComfortSSig</SHORT-NAME></SYSTEM-SIGNAL>
            <I-SIGNAL><SHORT-NAME>ComfortISig</SHORT-NAME><SYSTEM-SIGNAL-REF DEST="SYSTEM-SIGNAL">/FV/Comm/ComfortSSig</SYSTEM-SIGNAL-REF></I-SIGNAL>
            <I-SIGNAL-I-PDU><SHORT-NAME>ComfortIPdu</SHORT-NAME><I-SIGNAL-TO-PDU-MAPPINGS><I-SIGNAL-TO-I-PDU-MAPPING><SHORT-NAME>ComfortMap</SHORT-NAME><I-SIGNAL-REF DEST="I-SIGNAL">/FV/Comm/ComfortISig</I-SIGNAL-REF></I-SIGNAL-TO-I-PDU-MAPPING></I-SIGNAL-TO-PDU-MAPPINGS></I-SIGNAL-I-PDU>

            <!-- Decel: ADAS -> BrakeCtl (SecOC) -->
            <SYSTEM-SIGNAL><SHORT-NAME>DecelSSig</SHORT-NAME></SYSTEM-SIGNAL>
            <I-SIGNAL><SHORT-NAME>DecelISig</SHORT-NAME><SYSTEM-SIGNAL-REF DEST="SYSTEM-SIGNAL">/FV/Comm/DecelSSig</SYSTEM-SIGNAL-REF></I-SIGNAL>
            <I-SIGNAL-I-PDU><SHORT-NAME>DecelIPdu</SHORT-NAME><I-SIGNAL-TO-PDU-MAPPINGS><I-SIGNAL-TO-I-PDU-MAPPING><SHORT-NAME>DecelMap</SHORT-NAME><I-SIGNAL-REF DEST="I-SIGNAL">/FV/Comm/DecelISig</I-SIGNAL-REF></I-SIGNAL-TO-I-PDU-MAPPING></I-SIGNAL-TO-PDU-MAPPINGS></I-SIGNAL-I-PDU>
            <SECURED-I-PDU><SHORT-NAME>DecelSecuredIPdu</SHORT-NAME><AUTH-INFO-TX-LENGTH>32</AUTH-INFO-TX-LENGTH><FRESHNESS-VALUE-ID>4</FRESHNESS-VALUE-ID><FRESHNESS-VALUE-LENGTH>8</FRESHNESS-VALUE-LENGTH><PAYLOAD-REF DEST="I-SIGNAL-I-PDU">/FV/Comm/DecelIPdu</PAYLOAD-REF></SECURED-I-PDU>

            <!-- Engine: GW -> Powertrain (SecOC) -->
            <SYSTEM-SIGNAL><SHORT-NAME>EngineSSig</SHORT-NAME></SYSTEM-SIGNAL>
            <I-SIGNAL><SHORT-NAME>EngineISig</SHORT-NAME><SYSTEM-SIGNAL-REF DEST="SYSTEM-SIGNAL">/FV/Comm/EngineSSig</SYSTEM-SIGNAL-REF></I-SIGNAL>
            <I-SIGNAL-I-PDU><SHORT-NAME>EngineIPdu</SHORT-NAME><I-SIGNAL-TO-PDU-MAPPINGS><I-SIGNAL-TO-I-PDU-MAPPING><SHORT-NAME>EngineMap</SHORT-NAME><I-SIGNAL-REF DEST="I-SIGNAL">/FV/Comm/EngineISig</I-SIGNAL-REF></I-SIGNAL-TO-I-PDU-MAPPING></I-SIGNAL-TO-PDU-MAPPINGS></I-SIGNAL-I-PDU>
            <SECURED-I-PDU><SHORT-NAME>EngineSecuredIPdu</SHORT-NAME><AUTH-INFO-TX-LENGTH>32</AUTH-INFO-TX-LENGTH><FRESHNESS-VALUE-ID>5</FRESHNESS-VALUE-ID><FRESHNESS-VALUE-LENGTH>8</FRESHNESS-VALUE-LENGTH><PAYLOAD-REF DEST="I-SIGNAL-I-PDU">/FV/Comm/EngineIPdu</PAYLOAD-REF></SECURED-I-PDU>

            <!-- Body: GW -> BCM (no SecOC) -->
            <SYSTEM-SIGNAL><SHORT-NAME>BodySSig</SHORT-NAME></SYSTEM-SIGNAL>
            <I-SIGNAL><SHORT-NAME>BodyISig</SHORT-NAME><SYSTEM-SIGNAL-REF DEST="SYSTEM-SIGNAL">/FV/Comm/BodySSig</SYSTEM-SIGNAL-REF></I-SIGNAL>
            <I-SIGNAL-I-PDU><SHORT-NAME>BodyIPdu</SHORT-NAME><I-SIGNAL-TO-PDU-MAPPINGS><I-SIGNAL-TO-I-PDU-MAPPING><SHORT-NAME>BodyMap</SHORT-NAME><I-SIGNAL-REF DEST="I-SIGNAL">/FV/Comm/BodyISig</I-SIGNAL-REF></I-SIGNAL-TO-I-PDU-MAPPING></I-SIGNAL-TO-PDU-MAPPINGS></I-SIGNAL-I-PDU>

            <!-- Light: GW -> Headlight (no SecOC) -->
            <SYSTEM-SIGNAL><SHORT-NAME>LightSSig</SHORT-NAME></SYSTEM-SIGNAL>
            <I-SIGNAL><SHORT-NAME>LightISig</SHORT-NAME><SYSTEM-SIGNAL-REF DEST="SYSTEM-SIGNAL">/FV/Comm/LightSSig</SYSTEM-SIGNAL-REF></I-SIGNAL>
            <I-SIGNAL-I-PDU><SHORT-NAME>LightIPdu</SHORT-NAME><I-SIGNAL-TO-PDU-MAPPINGS><I-SIGNAL-TO-I-PDU-MAPPING><SHORT-NAME>LightMap</SHORT-NAME><I-SIGNAL-REF DEST="I-SIGNAL">/FV/Comm/LightISig</I-SIGNAL-REF></I-SIGNAL-TO-I-PDU-MAPPING></I-SIGNAL-TO-PDU-MAPPINGS></I-SIGNAL-I-PDU>
          </ELEMENTS>
        </AR-PACKAGE>

