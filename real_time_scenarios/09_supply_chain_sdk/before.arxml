                <SW-COMPONENT-PROTOTYPE><SHORT-NAME>taillight</SHORT-NAME><TYPE-TREF DEST="SENSOR-ACTUATOR-SW-COMPONENT-TYPE">/FV/Swc/TaillightCtrl</TYPE-TREF></SW-COMPONENT-PROTOTYPE>
                <SW-COMPONENT-PROTOTYPE><SHORT-NAME>ambientLight</SHORT-NAME><TYPE-TREF DEST="APPLICATION-SW-COMPONENT-TYPE">/FV/Swc/AmbientLightCtrl</TYPE-TREF></SW-COMPONENT-PROTOTYPE>
              </COMPONENTS>
              <CONNECTORS>
                <!-- Infotainment internal -->
                <ASSEMBLY-SW-CONNECTOR><SHORT-NAME>btToIvi</SHORT-NAME><PROVIDER-IREF><CONTEXT-COMPONENT-REF DEST="SW-COMPONENT-PROTOTYPE">/FV/Swc/FullVehicle/btStack</CONTEXT-COMPONENT-REF><TARGET-P-PORT-REF DEST="P-PORT-PROTOTYPE">/FV/Swc/BluetoothStack/MediaOut</TARGET-P-PORT-REF></PROVIDER-IREF><REQUESTER-IREF><CONTEXT-COMPONENT-REF DEST="SW-COMPONENT-PROTOTYPE">/FV/Swc/FullVehicle/ivi</CONTEXT-COMPONENT-REF><TARGET-R-PORT-REF DEST="R-PORT-PROTOTYPE">/FV/Swc/InfotainmentHU/MediaIn</TARGET-R-PORT-REF></REQUESTER-IREF></ASSEMBLY-SW-CONNECTOR>
                <ASSEMBLY-SW-CONNECTOR><SHORT-NAME>iviToMedia</SHORT-NAME><PROVIDER-IREF><CONTEXT-COMPONENT-REF DEST="SW-COMPONENT-PROTOTYPE">/FV/Swc/FullVehicle/ivi</CONTEXT-COMPONENT-REF><TARGET-P-PORT-REF DEST="P-PORT-PROTOTYPE">/FV/Swc/InfotainmentHU/StreamOut</TARGET-P-PORT-REF></PROVIDER-IREF><REQUESTER-IREF><CONTEXT-COMPONENT-REF DEST="SW-COMPONENT-PROTOTYPE">/FV/Swc/FullVehicle/mediaPlayer</CONTEXT-COMPONENT-REF><TARGET-R-PORT-REF DEST="R-PORT-PROTOTYPE">/FV/Swc/MediaPlayer/StreamIn</TARGET-R-PORT-REF></REQUESTER-IREF></ASSEMBLY-SW-CONNECTOR>
