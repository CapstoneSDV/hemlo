<?xml version='1.0' encoding='UTF-8'?>
<!-- Full Vehicle Architecture: 24 SW-component prototypes across 8 ECU domains.
     Modeled after a modern zonal E/E architecture with:
       - Infotainment domain  (IviEcu):       btStack, ivi, mediaPlayer
       - Telematics domain    (TelematicsEcu): tcu, otaManager, v2xStack
       - Gateway domain       (GatewayEcu):    cgw, diagRouter, firewallMgr
       - ADAS domain          (AdasEcu):       adas, objDetect, laneKeep
       - Chassis domain       (ChassisEcu):    brakeCtl, brakeAct, steerCtl
       - Powertrain domain    (PtEcu):         engineCtl, transCtl, emisCtl
       - Body domain          (BodyEcu):       bcm, doorLock, hvacCtl
       - Lighting domain      (LightEcu):      headlight, taillight, ambientLight

     Hop map (24 nodes, 23 connectors across/within 8 ECUs):
       btStack   -> ivi           IviEcu -> IviEcu         RTE-local
       ivi       -> mediaPlayer   IviEcu -> IviEcu         RTE-local
       ivi       -> cgw           IviEcu -> GatewayEcu     BUS, SecOC (NavSecuredIPdu)
       tcu       -> cgw           TelematicsEcu -> GatewayEcu  BUS, SecOC (TcuGwSecuredIPdu)
       otaManager-> cgw           TelematicsEcu -> GatewayEcu  BUS (OtaIPdu, no SecOC yet - plumbed)
       v2xStack  -> cgw           TelematicsEcu -> GatewayEcu  BUS, SecOC (V2xSecuredIPdu)
       cgw       -> diagRouter    GatewayEcu -> GatewayEcu  RTE-local
       cgw       -> firewallMgr   GatewayEcu -> GatewayEcu  RTE-local
       cgw       -> adas          GatewayEcu -> AdasEcu     BUS, SecOC (ComfortSecuredIPdu)
       adas      -> objDetect     AdasEcu -> AdasEcu        RTE-local
       adas      -> laneKeep      AdasEcu -> AdasEcu        RTE-local
       adas      -> brakeCtl      AdasEcu -> ChassisEcu     BUS, SecOC (DecelSecuredIPdu)
       brakeCtl  -> brakeAct      ChassisEcu -> ChassisEcu  RTE-local
       brakeCtl  -> steerCtl      ChassisEcu -> ChassisEcu  RTE-local
       cgw       -> engineCtl     GatewayEcu -> PtEcu       BUS, SecOC (EngineSecuredIPdu)
       engineCtl -> transCtl      PtEcu -> PtEcu            RTE-local
       engineCtl -> emisCtl       PtEcu -> PtEcu            RTE-local
       cgw       -> bcm           GatewayEcu -> BodyEcu     BUS (BodyIPdu, no SecOC)
       bcm       -> doorLock      BodyEcu -> BodyEcu        RTE-local
       bcm       -> hvacCtl       BodyEcu -> BodyEcu        RTE-local
       cgw       -> headlight     GatewayEcu -> LightEcu    BUS (LightIPdu, no SecOC)
       headlight -> taillight     LightEcu -> LightEcu      RTE-local
       headlight -> ambientLight  LightEcu -> LightEcu      RTE-local

     Key security design: Gateway deliberately does NOT bridge IVI/TCU directly to
     chassis/ADAS unless the ComfortMode connector is enabled. Scenarios inject
     attack vectors that bypass this isolation.
-->
<AUTOSAR xmlns="http://autosar.org/schema/r4.0">
  <AR-PACKAGES>
    <AR-PACKAGE>
      <SHORT-NAME>FV</SHORT-NAME>
      <AR-PACKAGES>

        <!-- ============================================================= -->
        <!-- INTERFACES                                                      -->
        <!-- ============================================================= -->
        <AR-PACKAGE>
          <SHORT-NAME>If</SHORT-NAME>
          <ELEMENTS>
            <SENDER-RECEIVER-INTERFACE><SHORT-NAME>MediaReq</SHORT-NAME><DATA-ELEMENTS><VARIABLE-DATA-PROTOTYPE><SHORT-NAME>payload</SHORT-NAME></VARIABLE-DATA-PROTOTYPE></DATA-ELEMENTS></SENDER-RECEIVER-INTERFACE>
            <SENDER-RECEIVER-INTERFACE><SHORT-NAME>MediaStream</SHORT-NAME><DATA-ELEMENTS><VARIABLE-DATA-PROTOTYPE><SHORT-NAME>stream</SHORT-NAME></VARIABLE-DATA-PROTOTYPE></DATA-ELEMENTS></SENDER-RECEIVER-INTERFACE>
            <SENDER-RECEIVER-INTERFACE><SHORT-NAME>NavRoute</SHORT-NAME><DATA-ELEMENTS><VARIABLE-DATA-PROTOTYPE><SHORT-NAME>route</SHORT-NAME></VARIABLE-DATA-PROTOTYPE></DATA-ELEMENTS></SENDER-RECEIVER-INTERFACE>
            <SENDER-RECEIVER-INTERFACE><SHORT-NAME>RemoteSvc</SHORT-NAME><DATA-ELEMENTS><VARIABLE-DATA-PROTOTYPE><SHORT-NAME>val</SHORT-NAME></VARIABLE-DATA-PROTOTYPE></DATA-ELEMENTS></SENDER-RECEIVER-INTERFACE>
            <SENDER-RECEIVER-INTERFACE><SHORT-NAME>OtaCmd</SHORT-NAME><DATA-ELEMENTS><VARIABLE-DATA-PROTOTYPE><SHORT-NAME>pkg</SHORT-NAME></VARIABLE-DATA-PROTOTYPE></DATA-ELEMENTS></SENDER-RECEIVER-INTERFACE>
            <SENDER-RECEIVER-INTERFACE><SHORT-NAME>V2xMsg</SHORT-NAME><DATA-ELEMENTS><VARIABLE-DATA-PROTOTYPE><SHORT-NAME>msg</SHORT-NAME></VARIABLE-DATA-PROTOTYPE></DATA-ELEMENTS></SENDER-RECEIVER-INTERFACE>
            <SENDER-RECEIVER-INTERFACE><SHORT-NAME>DiagCmd</SHORT-NAME><DATA-ELEMENTS><VARIABLE-DATA-PROTOTYPE><SHORT-NAME>cmd</SHORT-NAME></VARIABLE-DATA-PROTOTYPE></DATA-ELEMENTS></SENDER-RECEIVER-INTERFACE>
            <SENDER-RECEIVER-INTERFACE><SHORT-NAME>FwPolicy</SHORT-NAME><DATA-ELEMENTS><VARIABLE-DATA-PROTOTYPE><SHORT-NAME>rule</SHORT-NAME></VARIABLE-DATA-PROTOTYPE></DATA-ELEMENTS></SENDER-RECEIVER-INTERFACE>
            <SENDER-RECEIVER-INTERFACE><SHORT-NAME>ComfortMode</SHORT-NAME><DATA-ELEMENTS><VARIABLE-DATA-PROTOTYPE><SHORT-NAME>mode</SHORT-NAME></VARIABLE-DATA-PROTOTYPE></DATA-ELEMENTS></SENDER-RECEIVER-INTERFACE>
            <SENDER-RECEIVER-INTERFACE><SHORT-NAME>ObjData</SHORT-NAME><DATA-ELEMENTS><VARIABLE-DATA-PROTOTYPE><SHORT-NAME>objects</SHORT-NAME></VARIABLE-DATA-PROTOTYPE></DATA-ELEMENTS></SENDER-RECEIVER-INTERFACE>
            <SENDER-RECEIVER-INTERFACE><SHORT-NAME>LaneData</SHORT-NAME><DATA-ELEMENTS><VARIABLE-DATA-PROTOTYPE><SHORT-NAME>lanes</SHORT-NAME></VARIABLE-DATA-PROTOTYPE></DATA-ELEMENTS></SENDER-RECEIVER-INTERFACE>
            <SENDER-RECEIVER-INTERFACE><SHORT-NAME>DecelReq</SHORT-NAME><DATA-ELEMENTS><VARIABLE-DATA-PROTOTYPE><SHORT-NAME>decel</SHORT-NAME></VARIABLE-DATA-PROTOTYPE></DATA-ELEMENTS></SENDER-RECEIVER-INTERFACE>
            <SENDER-RECEIVER-INTERFACE><SHORT-NAME>BrakeForce</SHORT-NAME><DATA-ELEMENTS><VARIABLE-DATA-PROTOTYPE><SHORT-NAME>force</SHORT-NAME></VARIABLE-DATA-PROTOTYPE></DATA-ELEMENTS></SENDER-RECEIVER-INTERFACE>
            <SENDER-RECEIVER-INTERFACE><SHORT-NAME>SteerAngle</SHORT-NAME><DATA-ELEMENTS><VARIABLE-DATA-PROTOTYPE><SHORT-NAME>angle</SHORT-NAME></VARIABLE-DATA-PROTOTYPE></DATA-ELEMENTS></SENDER-RECEIVER-INTERFACE>
            <SENDER-RECEIVER-INTERFACE><SHORT-NAME>EngineCmd</SHORT-NAME><DATA-ELEMENTS><VARIABLE-DATA-PROTOTYPE><SHORT-NAME>torque</SHORT-NAME></VARIABLE-DATA-PROTOTYPE></DATA-ELEMENTS></SENDER-RECEIVER-INTERFACE>
            <SENDER-RECEIVER-INTERFACE><SHORT-NAME>TransGear</SHORT-NAME><DATA-ELEMENTS><VARIABLE-DATA-PROTOTYPE><SHORT-NAME>gear</SHORT-NAME></VARIABLE-DATA-PROTOTYPE></DATA-ELEMENTS></SENDER-RECEIVER-INTERFACE>
            <SENDER-RECEIVER-INTERFACE><SHORT-NAME>EmisData</SHORT-NAME><DATA-ELEMENTS><VARIABLE-DATA-PROTOTYPE><SHORT-NAME>emis</SHORT-NAME></VARIABLE-DATA-PROTOTYPE></DATA-ELEMENTS></SENDER-RECEIVER-INTERFACE>
            <SENDER-RECEIVER-INTERFACE><SHORT-NAME>BodyCmd</SHORT-NAME><DATA-ELEMENTS><VARIABLE-DATA-PROTOTYPE><SHORT-NAME>cmd</SHORT-NAME></VARIABLE-DATA-PROTOTYPE></DATA-ELEMENTS></SENDER-RECEIVER-INTERFACE>
            <SENDER-RECEIVER-INTERFACE><SHORT-NAME>DoorCmd</SHORT-NAME><DATA-ELEMENTS><VARIABLE-DATA-PROTOTYPE><SHORT-NAME>lock</SHORT-NAME></VARIABLE-DATA-PROTOTYPE></DATA-ELEMENTS></SENDER-RECEIVER-INTERFACE>
            <SENDER-RECEIVER-INTERFACE><SHORT-NAME>HvacCmd</SHORT-NAME><DATA-ELEMENTS><VARIABLE-DATA-PROTOTYPE><SHORT-NAME>temp</SHORT-NAME></VARIABLE-DATA-PROTOTYPE></DATA-ELEMENTS></SENDER-RECEIVER-INTERFACE>
            <SENDER-RECEIVER-INTERFACE><SHORT-NAME>LightCmd</SHORT-NAME><DATA-ELEMENTS><VARIABLE-DATA-PROTOTYPE><SHORT-NAME>level</SHORT-NAME></VARIABLE-DATA-PROTOTYPE></DATA-ELEMENTS></SENDER-RECEIVER-INTERFACE>
            <SENDER-RECEIVER-INTERFACE><SHORT-NAME>TailCmd</SHORT-NAME><DATA-ELEMENTS><VARIABLE-DATA-PROTOTYPE><SHORT-NAME>level</SHORT-NAME></VARIABLE-DATA-PROTOTYPE></DATA-ELEMENTS></SENDER-RECEIVER-INTERFACE>
            <SENDER-RECEIVER-INTERFACE><SHORT-NAME>AmbientCmd</SHORT-NAME><DATA-ELEMENTS><VARIABLE-DATA-PROTOTYPE><SHORT-NAME>color</SHORT-NAME></VARIABLE-DATA-PROTOTYPE></DATA-ELEMENTS></SENDER-RECEIVER-INTERFACE>
          </ELEMENTS>
        </AR-PACKAGE>

        <!-- ============================================================= -->
        <!-- SW COMPONENT TYPES                                              -->
        <!-- ============================================================= -->
        <AR-PACKAGE>
          <SHORT-NAME>Swc</SHORT-NAME>
          <ELEMENTS>
            <!-- Infotainment -->
            <APPLICATION-SW-COMPONENT-TYPE><SHORT-NAME>BluetoothStack</SHORT-NAME><PORTS>
              <P-PORT-PROTOTYPE><SHORT-NAME>MediaOut</SHORT-NAME><PROVIDED-INTERFACE-TREF DEST="SENDER-RECEIVER-INTERFACE">/FV/If/MediaReq</PROVIDED-INTERFACE-TREF></P-PORT-PROTOTYPE>
            </PORTS></APPLICATION-SW-COMPONENT-TYPE>

            <APPLICATION-SW-COMPONENT-TYPE><SHORT-NAME>InfotainmentHU</SHORT-NAME><PORTS>
              <R-PORT-PROTOTYPE><SHORT-NAME>MediaIn</SHORT-NAME><REQUIRED-INTERFACE-TREF DEST="SENDER-RECEIVER-INTERFACE">/FV/If/MediaReq</REQUIRED-INTERFACE-TREF></R-PORT-PROTOTYPE>
              <P-PORT-PROTOTYPE><SHORT-NAME>StreamOut</SHORT-NAME><PROVIDED-INTERFACE-TREF DEST="SENDER-RECEIVER-INTERFACE">/FV/If/MediaStream</PROVIDED-INTERFACE-TREF></P-PORT-PROTOTYPE>
              <P-PORT-PROTOTYPE><SHORT-NAME>NavOut</SHORT-NAME><PROVIDED-INTERFACE-TREF DEST="SENDER-RECEIVER-INTERFACE">/FV/If/NavRoute</PROVIDED-INTERFACE-TREF></P-PORT-PROTOTYPE>
            </PORTS></APPLICATION-SW-COMPONENT-TYPE>

            <APPLICATION-SW-COMPONENT-TYPE><SHORT-NAME>MediaPlayer</SHORT-NAME><PORTS>
              <R-PORT-PROTOTYPE><SHORT-NAME>StreamIn</SHORT-NAME><REQUIRED-INTERFACE-TREF DEST="SENDER-RECEIVER-INTERFACE">/FV/If/MediaStream</REQUIRED-INTERFACE-TREF></R-PORT-PROTOTYPE>
            </PORTS></APPLICATION-SW-COMPONENT-TYPE>

            <!-- Telematics -->
            <APPLICATION-SW-COMPONENT-TYPE><SHORT-NAME>TelematicsUnit</SHORT-NAME><PORTS>
              <P-PORT-PROTOTYPE><SHORT-NAME>RemoteOut</SHORT-NAME><PROVIDED-INTERFACE-TREF DEST="SENDER-RECEIVER-INTERFACE">/FV/If/RemoteSvc</PROVIDED-INTERFACE-TREF></P-PORT-PROTOTYPE>
            </PORTS></APPLICATION-SW-COMPONENT-TYPE>

            <APPLICATION-SW-COMPONENT-TYPE><SHORT-NAME>OtaManager</SHORT-NAME><PORTS>
              <P-PORT-PROTOTYPE><SHORT-NAME>OtaOut</SHORT-NAME><PROVIDED-INTERFACE-TREF DEST="SENDER-RECEIVER-INTERFACE">/FV/If/OtaCmd</PROVIDED-INTERFACE-TREF></P-PORT-PROTOTYPE>
            </PORTS></APPLICATION-SW-COMPONENT-TYPE>

            <APPLICATION-SW-COMPONENT-TYPE><SHORT-NAME>V2xStack</SHORT-NAME><PORTS>
              <P-PORT-PROTOTYPE><SHORT-NAME>V2xOut</SHORT-NAME><PROVIDED-INTERFACE-TREF DEST="SENDER-RECEIVER-INTERFACE">/FV/If/V2xMsg</PROVIDED-INTERFACE-TREF></P-PORT-PROTOTYPE>
            </PORTS></APPLICATION-SW-COMPONENT-TYPE>

            <!-- Gateway -->
            <APPLICATION-SW-COMPONENT-TYPE><SHORT-NAME>CentralGateway</SHORT-NAME><PORTS>
              <R-PORT-PROTOTYPE><SHORT-NAME>NavIn</SHORT-NAME><REQUIRED-INTERFACE-TREF DEST="SENDER-RECEIVER-INTERFACE">/FV/If/NavRoute</REQUIRED-INTERFACE-TREF></R-PORT-PROTOTYPE>
              <R-PORT-PROTOTYPE><SHORT-NAME>RemoteIn</SHORT-NAME><REQUIRED-INTERFACE-TREF DEST="SENDER-RECEIVER-INTERFACE">/FV/If/RemoteSvc</REQUIRED-INTERFACE-TREF></R-PORT-PROTOTYPE>
              <R-PORT-PROTOTYPE><SHORT-NAME>OtaIn</SHORT-NAME><REQUIRED-INTERFACE-TREF DEST="SENDER-RECEIVER-INTERFACE">/FV/If/OtaCmd</REQUIRED-INTERFACE-TREF></R-PORT-PROTOTYPE>
              <R-PORT-PROTOTYPE><SHORT-NAME>V2xIn</SHORT-NAME><REQUIRED-INTERFACE-TREF DEST="SENDER-RECEIVER-INTERFACE">/FV/If/V2xMsg</REQUIRED-INTERFACE-TREF></R-PORT-PROTOTYPE>
              <P-PORT-PROTOTYPE><SHORT-NAME>DiagOut</SHORT-NAME><PROVIDED-INTERFACE-TREF DEST="SENDER-RECEIVER-INTERFACE">/FV/If/DiagCmd</PROVIDED-INTERFACE-TREF></P-PORT-PROTOTYPE>
              <P-PORT-PROTOTYPE><SHORT-NAME>FwOut</SHORT-NAME><PROVIDED-INTERFACE-TREF DEST="SENDER-RECEIVER-INTERFACE">/FV/If/FwPolicy</PROVIDED-INTERFACE-TREF></P-PORT-PROTOTYPE>
              <P-PORT-PROTOTYPE><SHORT-NAME>ComfortOut</SHORT-NAME><PROVIDED-INTERFACE-TREF DEST="SENDER-RECEIVER-INTERFACE">/FV/If/ComfortMode</PROVIDED-INTERFACE-TREF></P-PORT-PROTOTYPE>
              <P-PORT-PROTOTYPE><SHORT-NAME>EngineOut</SHORT-NAME><PROVIDED-INTERFACE-TREF DEST="SENDER-RECEIVER-INTERFACE">/FV/If/EngineCmd</PROVIDED-INTERFACE-TREF></P-PORT-PROTOTYPE>
              <P-PORT-PROTOTYPE><SHORT-NAME>BodyOut</SHORT-NAME><PROVIDED-INTERFACE-TREF DEST="SENDER-RECEIVER-INTERFACE">/FV/If/BodyCmd</PROVIDED-INTERFACE-TREF></P-PORT-PROTOTYPE>
              <P-PORT-PROTOTYPE><SHORT-NAME>LightOut</SHORT-NAME><PROVIDED-INTERFACE-TREF DEST="SENDER-RECEIVER-INTERFACE">/FV/If/LightCmd</PROVIDED-INTERFACE-TREF></P-PORT-PROTOTYPE>
            </PORTS></APPLICATION-SW-COMPONENT-TYPE>

            <APPLICATION-SW-COMPONENT-TYPE><SHORT-NAME>DiagnosticRouter</SHORT-NAME><PORTS>
              <R-PORT-PROTOTYPE><SHORT-NAME>DiagIn</SHORT-NAME><REQUIRED-INTERFACE-TREF DEST="SENDER-RECEIVER-INTERFACE">/FV/If/DiagCmd</REQUIRED-INTERFACE-TREF></R-PORT-PROTOTYPE>
            </PORTS></APPLICATION-SW-COMPONENT-TYPE>

            <APPLICATION-SW-COMPONENT-TYPE><SHORT-NAME>FirewallManager</SHORT-NAME><PORTS>
              <R-PORT-PROTOTYPE><SHORT-NAME>FwIn</SHORT-NAME><REQUIRED-INTERFACE-TREF DEST="SENDER-RECEIVER-INTERFACE">/FV/If/FwPolicy</REQUIRED-INTERFACE-TREF></R-PORT-PROTOTYPE>
            </PORTS></APPLICATION-SW-COMPONENT-TYPE>

            <!-- ADAS -->
            <APPLICATION-SW-COMPONENT-TYPE><SHORT-NAME>AdasPlanner</SHORT-NAME><PORTS>
              <R-PORT-PROTOTYPE><SHORT-NAME>ComfortIn</SHORT-NAME><REQUIRED-INTERFACE-TREF DEST="SENDER-RECEIVER-INTERFACE">/FV/If/ComfortMode</REQUIRED-INTERFACE-TREF></R-PORT-PROTOTYPE>
              <P-PORT-PROTOTYPE><SHORT-NAME>ObjOut</SHORT-NAME><PROVIDED-INTERFACE-TREF DEST="SENDER-RECEIVER-INTERFACE">/FV/If/ObjData</PROVIDED-INTERFACE-TREF></P-PORT-PROTOTYPE>
              <P-PORT-PROTOTYPE><SHORT-NAME>LaneOut</SHORT-NAME><PROVIDED-INTERFACE-TREF DEST="SENDER-RECEIVER-INTERFACE">/FV/If/LaneData</PROVIDED-INTERFACE-TREF></P-PORT-PROTOTYPE>
              <P-PORT-PROTOTYPE><SHORT-NAME>DecelOut</SHORT-NAME><PROVIDED-INTERFACE-TREF DEST="SENDER-RECEIVER-INTERFACE">/FV/If/DecelReq</PROVIDED-INTERFACE-TREF></P-PORT-PROTOTYPE>
            </PORTS></APPLICATION-SW-COMPONENT-TYPE>

            <APPLICATION-SW-COMPONENT-TYPE><SHORT-NAME>ObjectDetector</SHORT-NAME><PORTS>
              <R-PORT-PROTOTYPE><SHORT-NAME>ObjIn</SHORT-NAME><REQUIRED-INTERFACE-TREF DEST="SENDER-RECEIVER-INTERFACE">/FV/If/ObjData</REQUIRED-INTERFACE-TREF></R-PORT-PROTOTYPE>
            </PORTS></APPLICATION-SW-COMPONENT-TYPE>

            <APPLICATION-SW-COMPONENT-TYPE><SHORT-NAME>LaneKeepAssist</SHORT-NAME><PORTS>
              <R-PORT-PROTOTYPE><SHORT-NAME>LaneIn</SHORT-NAME><REQUIRED-INTERFACE-TREF DEST="SENDER-RECEIVER-INTERFACE">/FV/If/LaneData</REQUIRED-INTERFACE-TREF></R-PORT-PROTOTYPE>
            </PORTS></APPLICATION-SW-COMPONENT-TYPE>

            <!-- Chassis -->
            <APPLICATION-SW-COMPONENT-TYPE><SHORT-NAME>BrakeController</SHORT-NAME><PORTS>
              <R-PORT-PROTOTYPE><SHORT-NAME>DecelIn</SHORT-NAME><REQUIRED-INTERFACE-TREF DEST="SENDER-RECEIVER-INTERFACE">/FV/If/DecelReq</REQUIRED-INTERFACE-TREF></R-PORT-PROTOTYPE>
              <P-PORT-PROTOTYPE><SHORT-NAME>ForceOut</SHORT-NAME><PROVIDED-INTERFACE-TREF DEST="SENDER-RECEIVER-INTERFACE">/FV/If/BrakeForce</PROVIDED-INTERFACE-TREF></P-PORT-PROTOTYPE>
              <P-PORT-PROTOTYPE><SHORT-NAME>SteerOut</SHORT-NAME><PROVIDED-INTERFACE-TREF DEST="SENDER-RECEIVER-INTERFACE">/FV/If/SteerAngle</PROVIDED-INTERFACE-TREF></P-PORT-PROTOTYPE>
            </PORTS></APPLICATION-SW-COMPONENT-TYPE>

            <SENSOR-ACTUATOR-SW-COMPONENT-TYPE><SHORT-NAME>BrakeActuator</SHORT-NAME><PORTS>
              <R-PORT-PROTOTYPE><SHORT-NAME>ForceIn</SHORT-NAME><REQUIRED-INTERFACE-TREF DEST="SENDER-RECEIVER-INTERFACE">/FV/If/BrakeForce</REQUIRED-INTERFACE-TREF></R-PORT-PROTOTYPE>
            </PORTS></SENSOR-ACTUATOR-SW-COMPONENT-TYPE>

            <SENSOR-ACTUATOR-SW-COMPONENT-TYPE><SHORT-NAME>SteeringController</SHORT-NAME><PORTS>
              <R-PORT-PROTOTYPE><SHORT-NAME>SteerIn</SHORT-NAME><REQUIRED-INTERFACE-TREF DEST="SENDER-RECEIVER-INTERFACE">/FV/If/SteerAngle</REQUIRED-INTERFACE-TREF></R-PORT-PROTOTYPE>
            </PORTS></SENSOR-ACTUATOR-SW-COMPONENT-TYPE>

            <!-- Powertrain -->
            <APPLICATION-SW-COMPONENT-TYPE><SHORT-NAME>EngineController</SHORT-NAME><PORTS>
              <R-PORT-PROTOTYPE><SHORT-NAME>EngIn</SHORT-NAME><REQUIRED-INTERFACE-TREF DEST="SENDER-RECEIVER-INTERFACE">/FV/If/EngineCmd</REQUIRED-INTERFACE-TREF></R-PORT-PROTOTYPE>
              <P-PORT-PROTOTYPE><SHORT-NAME>TransOut</SHORT-NAME><PROVIDED-INTERFACE-TREF DEST="SENDER-RECEIVER-INTERFACE">/FV/If/TransGear</PROVIDED-INTERFACE-TREF></P-PORT-PROTOTYPE>
              <P-PORT-PROTOTYPE><SHORT-NAME>EmisOut</SHORT-NAME><PROVIDED-INTERFACE-TREF DEST="SENDER-RECEIVER-INTERFACE">/FV/If/EmisData</PROVIDED-INTERFACE-TREF></P-PORT-PROTOTYPE>
            </PORTS></APPLICATION-SW-COMPONENT-TYPE>

            <APPLICATION-SW-COMPONENT-TYPE><SHORT-NAME>TransmissionCtrl</SHORT-NAME><PORTS>
              <R-PORT-PROTOTYPE><SHORT-NAME>TransIn</SHORT-NAME><REQUIRED-INTERFACE-TREF DEST="SENDER-RECEIVER-INTERFACE">/FV/If/TransGear</REQUIRED-INTERFACE-TREF></R-PORT-PROTOTYPE>
            </PORTS></APPLICATION-SW-COMPONENT-TYPE>

            <APPLICATION-SW-COMPONENT-TYPE><SHORT-NAME>EmissionsCtrl</SHORT-NAME><PORTS>
              <R-PORT-PROTOTYPE><SHORT-NAME>EmisIn</SHORT-NAME><REQUIRED-INTERFACE-TREF DEST="SENDER-RECEIVER-INTERFACE">/FV/If/EmisData</REQUIRED-INTERFACE-TREF></R-PORT-PROTOTYPE>
            </PORTS></APPLICATION-SW-COMPONENT-TYPE>

            <!-- Body -->
            <APPLICATION-SW-COMPONENT-TYPE><SHORT-NAME>BodyControlModule</SHORT-NAME><PORTS>
              <R-PORT-PROTOTYPE><SHORT-NAME>BodyIn</SHORT-NAME><REQUIRED-INTERFACE-TREF DEST="SENDER-RECEIVER-INTERFACE">/FV/If/BodyCmd</REQUIRED-INTERFACE-TREF></R-PORT-PROTOTYPE>
              <P-PORT-PROTOTYPE><SHORT-NAME>DoorOut</SHORT-NAME><PROVIDED-INTERFACE-TREF DEST="SENDER-RECEIVER-INTERFACE">/FV/If/DoorCmd</PROVIDED-INTERFACE-TREF></P-PORT-PROTOTYPE>
              <P-PORT-PROTOTYPE><SHORT-NAME>HvacOut</SHORT-NAME><PROVIDED-INTERFACE-TREF DEST="SENDER-RECEIVER-INTERFACE">/FV/If/HvacCmd</PROVIDED-INTERFACE-TREF></P-PORT-PROTOTYPE>
            </PORTS></APPLICATION-SW-COMPONENT-TYPE>

            <SENSOR-ACTUATOR-SW-COMPONENT-TYPE><SHORT-NAME>DoorLockActuator</SHORT-NAME><PORTS>
              <R-PORT-PROTOTYPE><SHORT-NAME>DoorIn</SHORT-NAME><REQUIRED-INTERFACE-TREF DEST="SENDER-RECEIVER-INTERFACE">/FV/If/DoorCmd</REQUIRED-INTERFACE-TREF></R-PORT-PROTOTYPE>
            </PORTS></SENSOR-ACTUATOR-SW-COMPONENT-TYPE>

            <APPLICATION-SW-COMPONENT-TYPE><SHORT-NAME>HvacController</SHORT-NAME><PORTS>
              <R-PORT-PROTOTYPE><SHORT-NAME>HvacIn</SHORT-NAME><REQUIRED-INTERFACE-TREF DEST="SENDER-RECEIVER-INTERFACE">/FV/If/HvacCmd</REQUIRED-INTERFACE-TREF></R-PORT-PROTOTYPE>
            </PORTS></APPLICATION-SW-COMPONENT-TYPE>

            <!-- Lighting -->
            <APPLICATION-SW-COMPONENT-TYPE><SHORT-NAME>HeadlightCtrl</SHORT-NAME><PORTS>
              <R-PORT-PROTOTYPE><SHORT-NAME>LightIn</SHORT-NAME><REQUIRED-INTERFACE-TREF DEST="SENDER-RECEIVER-INTERFACE">/FV/If/LightCmd</REQUIRED-INTERFACE-TREF></R-PORT-PROTOTYPE>
              <P-PORT-PROTOTYPE><SHORT-NAME>TailOut</SHORT-NAME><PROVIDED-INTERFACE-TREF DEST="SENDER-RECEIVER-INTERFACE">/FV/If/TailCmd</PROVIDED-INTERFACE-TREF></P-PORT-PROTOTYPE>
              <P-PORT-PROTOTYPE><SHORT-NAME>AmbientOut</SHORT-NAME><PROVIDED-INTERFACE-TREF DEST="SENDER-RECEIVER-INTERFACE">/FV/If/AmbientCmd</PROVIDED-INTERFACE-TREF></P-PORT-PROTOTYPE>
            </PORTS></APPLICATION-SW-COMPONENT-TYPE>

            <SENSOR-ACTUATOR-SW-COMPONENT-TYPE><SHORT-NAME>TaillightCtrl</SHORT-NAME><PORTS>
              <R-PORT-PROTOTYPE><SHORT-NAME>TailIn</SHORT-NAME><REQUIRED-INTERFACE-TREF DEST="SENDER-RECEIVER-INTERFACE">/FV/If/TailCmd</REQUIRED-INTERFACE-TREF></R-PORT-PROTOTYPE>
            </PORTS></SENSOR-ACTUATOR-SW-COMPONENT-TYPE>

            <APPLICATION-SW-COMPONENT-TYPE><SHORT-NAME>AmbientLightCtrl</SHORT-NAME><PORTS>
              <R-PORT-PROTOTYPE><SHORT-NAME>AmbientIn</SHORT-NAME><REQUIRED-INTERFACE-TREF DEST="SENDER-RECEIVER-INTERFACE">/FV/If/AmbientCmd</REQUIRED-INTERFACE-TREF></R-PORT-PROTOTYPE>
            </PORTS></APPLICATION-SW-COMPONENT-TYPE>

            <!-- =========================================================== -->
            <!-- COMPOSITION: 24 prototype instances, 23 assembly connectors  -->
            <!-- =========================================================== -->
            <COMPOSITION-SW-COMPONENT-TYPE>
              <SHORT-NAME>FullVehicle</SHORT-NAME>
              <COMPONENTS>
                <!-- Infotainment -->
                <SW-COMPONENT-PROTOTYPE><SHORT-NAME>btStack</SHORT-NAME><TYPE-TREF DEST="APPLICATION-SW-COMPONENT-TYPE">/FV/Swc/BluetoothStack</TYPE-TREF></SW-COMPONENT-PROTOTYPE>
                <SW-COMPONENT-PROTOTYPE><SHORT-NAME>ivi</SHORT-NAME><TYPE-TREF DEST="APPLICATION-SW-COMPONENT-TYPE">/FV/Swc/InfotainmentHU</TYPE-TREF></SW-COMPONENT-PROTOTYPE>
                <SW-COMPONENT-PROTOTYPE><SHORT-NAME>mediaPlayer</SHORT-NAME><TYPE-TREF DEST="APPLICATION-SW-COMPONENT-TYPE">/FV/Swc/MediaPlayer</TYPE-TREF></SW-COMPONENT-PROTOTYPE>
                <!-- Telematics -->
                <SW-COMPONENT-PROTOTYPE><SHORT-NAME>tcu</SHORT-NAME><TYPE-TREF DEST="APPLICATION-SW-COMPONENT-TYPE">/FV/Swc/TelematicsUnit</TYPE-TREF></SW-COMPONENT-PROTOTYPE>
                <SW-COMPONENT-PROTOTYPE><SHORT-NAME>otaManager</SHORT-NAME><TYPE-TREF DEST="APPLICATION-SW-COMPONENT-TYPE">/FV/Swc/OtaManager</TYPE-TREF></SW-COMPONENT-PROTOTYPE>
                <SW-COMPONENT-PROTOTYPE><SHORT-NAME>v2xStack</SHORT-NAME><TYPE-TREF DEST="APPLICATION-SW-COMPONENT-TYPE">/FV/Swc/V2xStack</TYPE-TREF></SW-COMPONENT-PROTOTYPE>
                <!-- Gateway -->
                <SW-COMPONENT-PROTOTYPE><SHORT-NAME>cgw</SHORT-NAME><TYPE-TREF DEST="APPLICATION-SW-COMPONENT-TYPE">/FV/Swc/CentralGateway</TYPE-TREF></SW-COMPONENT-PROTOTYPE>
                <SW-COMPONENT-PROTOTYPE><SHORT-NAME>diagRouter</SHORT-NAME><TYPE-TREF DEST="APPLICATION-SW-COMPONENT-TYPE">/FV/Swc/DiagnosticRouter</TYPE-TREF></SW-COMPONENT-PROTOTYPE>
