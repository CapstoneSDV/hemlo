                <SW-COMPONENT-PROTOTYPE><SHORT-NAME>transCtl</SHORT-NAME><TYPE-TREF DEST="APPLICATION-SW-COMPONENT-TYPE">/FV/Swc/TransmissionCtrl</TYPE-TREF></SW-COMPONENT-PROTOTYPE>
                <SW-COMPONENT-PROTOTYPE><SHORT-NAME>emisCtl</SHORT-NAME><TYPE-TREF DEST="APPLICATION-SW-COMPONENT-TYPE">/FV/Swc/EmissionsCtrl</TYPE-TREF></SW-COMPONENT-PROTOTYPE>
