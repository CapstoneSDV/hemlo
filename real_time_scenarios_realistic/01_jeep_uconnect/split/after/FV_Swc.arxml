                  <EVENTS>
                    <DATA-RECEIVED-EVENT UUID="cc151835-7cea-5704-a79d-8fb22cf8db93">
                      <SHORT-NAME>Dre_LightIn</SHORT-NAME>
                      <START-ON-EVENT-REF DEST="RUNNABLE-ENTITY">/FV/Swc/HeadlightCtrl/Behavior/Run_LightIn_Rx</START-ON-EVENT-REF>
